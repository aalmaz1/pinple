# Flutter
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
*.iml

# Android
**/android/**/gradle-wrapper.jar
**/android/.gradle
**/android/captures/
**/android/gradlew
**/android/gradlew.bat
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java

# iOS
**/ios/**/*.mode1v3
**/ios/**/*.mode2v3
**/ios/**/*.moved-aside
**/ios/**/*.pbxuser
**/ios/**/*.perspectivev3
**/ios/**/DerivedData/
**/ios/.symlinks/
**/ios/**/Pods/

# IDE
.idea/
*.swp
*.swo
.DS_Store

# Misc - lock files (keep pubspec.lock for reproducible builds)
*.lock
!pubspec.lock

# Media / large binaries — never commit videos or archives
*.mp4
*.mov
*.avi
*.mkv
*.zip
*.aab
*.apk
*.ipa

# Environment & secrets
.env
*.jks
*.keystore

# OMC working directory
.omc/state/
.omc/project-memory.json

# Firebase platform configs (regenerate via `flutterfire configure`)
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
ios/firebase_app_id_file.json

# Preview / tool entry — not part of production build
# lib/main_preview.dart is intentionally kept untracked if used only for screenshots
